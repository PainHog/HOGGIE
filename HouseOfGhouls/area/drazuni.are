> speech_prog bestow~
if class($n) == Monk
if level($n) == 1
or level($n) == 2
mpoload 10320 1
mpoload 10330 1
mpoload 10330 1
mpoload 10331 1
put potion bag
put potion bag
put escape bag
give bag $n
mpechoat $n To use the potions, type 'quaff potion' or 'quaff elixir'.
mpechoat $n To use the scroll, type 'recite scroll'.
mpechoat $n Type 'exam bag' to see what is inside, and 'get <item> bag' or
mpechoat $n 'put <item> bag' to get and remove items.
mpechoat $n Use these items wisely, as they may save your life...
mpforce $n config +brief
mpforce $n wake
mpforce $n down
mpat $n mpforce $n config -brief
else
smile $n
mpechoat $n You are too high a level to need my assistance now.
endif
endif
~
