mpechoat $n Master Eganrac says 'When done here, leave up to explore the Realms.'
~
> rand_prog 100~
if level($r) == 1
mpechoat 0.$r Welcome, $r!
mpechoat 0.$r You have passed the Gates of Reallife and have entered the House of Ghouls!
mpechoat 0.$r Your accomplishment has earned you level two...
mpmset 0.$r align 0
mpechoat 0.$r Master Eganrac says 'Your alignment is set to &Pneutral&w!'
mpechoat 0.$r Master Eganrac says '&WIf you change your mind, the old sage might be able to help you!&w'
mpechoat 0.$r Master Eganrac says '&WOr worshipping one of the various demi-gods of the realms can change your alignment&w'
mpechoat 0.$r Master Eganrac says 'You are marked as a non-playerkiller...if you wish to change your status'
mpechoat 0.$r Master Eganrac says 'you need to sign the Book of Death in the Temple of Drazuk.'
mpadvance 0.$r 2
mpmset 0.$r practice 15
mpforce $r color theme hog
shout Please welcome a new adventurer to the Realm of House of Ghouls!
 if class($r) == mage
  shout The young Mage, $r ...
  endif
  if class($r) == cleric
  shout $r, an enlightened Cleric ...
  endif
  if class($r) == thief
  shout The sneaky Thief, $r ...
  endif
  if class($r) == thug
  shout The streetwise Thug, $r ...
  endif
  if class($r) == warrior
   shout A young Warrior called $r ...
  endif
  if class($r) == druid
   shout A wise Druid named $r ...
  endif
  if class($r) == ranger
   shout $r, a stout Ranger named $r...
  endif
  if class($r) == monk
   shout $r, a solemn Monk named $r...
  endif
  if class($r) == diabolist
   shout $r, a dark Diabolist named $r...
  endif
  if class($r) == jester
    shout $r, a quick Jester named $r...
  endif
  if class($r) == conjurer
   shout $r, a powerful Conjurer named $r...
  endif
  if class($r) == shaman
    shout $r, a mysterious Shaman named $r...
  endif
  mpechoat $r ... Please leave north to experience the University.
  mpechoat $r ... You may now "save" to make your character permanent.
endif~
> act_prog p is starved~
mpoload 20
give mushroom $n
mpforce 0.$n eat mushroom
mpechoat $n Master Eganrac says 'This will help your hunger, and your mental state.  Enjoy $n.'
~
> act_prog p is dying~
mpforce $n drink
mpechoat $n Master Eganrac says 'A drink from this fountain will quench your thirst and improve your mental state.'
~
