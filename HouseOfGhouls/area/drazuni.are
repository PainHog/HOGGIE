> act_prog p glances at you.~
nudge $n
if class ($n) == Cleric
  say This place is far too easy for a cleric of your power!
endif
if class($n) == Mage
  say Look at you!  Such a strong mage, and you're massacring gnolls?
endif
if class($n) == Thief
  say Look at you!  A stealthy thief, murdering gnolls?
endif
if class($n) == Warrior
  say Such a strong warrior, and you're killing gnolls?
endif
if class($n) == Thug
  say Shouldn't you be doing something a bit more noble?  A greater challenge?
endif
if class($n) == Druid
  say Do you not feel nature calling you to a greater challenge?
endif
if class($n) == Ranger
  say Such a strong ranger!  These gnolls are far too simple for you!
endif
if class($n) == Monk
  say Do you not crave a greater challenge?
endif
if class($n) == Jester
  say Look at you!  A jester, murdering gnolls?
endif
if class($n) == Diabolist
  say Look at you!  Such a mighty diabolist, and you're massacring gnolls?
endif
if class($n) == Conjurer
  say Look at you!  Such a powerful conjurer, and you're massacring gnolls?
endif
shake

~
