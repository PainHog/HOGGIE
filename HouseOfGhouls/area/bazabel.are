> rand_prog 75~
if iscarrying($r) == 39
   mpforce $r give drazukvilleticket transportmob
   mpjunk drazukvilleticket
   mptrans $r 21162
   mpat $r mea $r In a flash of light, you arrive at the Alden Transportal!
   mpat $r mer $r In a flash of light, $r arrives to the Transportal!
   mpat $r mpforce $r look
endif
~
> rand_prog 15~
say Make sure you have your ticket in your inventory!
~
