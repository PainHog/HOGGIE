0 0 2047 2105344 0 0 67109537 524295
> rand_prog 5~
ponder
say You know, I can "TEACH BLOODSONG" if you are advanced enough!
~
> speech_prog 'teach bloodsong'~
if isnohero($n)
    say Sorry $n, you need to be a hero before you can learn my skill
    smile $n
    break
else
   if questpoints($n) < 15000
       say Sorry $n, you need more quest points to learn my skill
        smile $n
        break
   else
       nod $n
       mppractice $n bloodsong 100
       mpmset $n questpoints 15000
       say Use your new skill wisely!
       salute $n
    endif
endif
~
> death_prog 5~
growl
say I place the curse of the God-Eater on you and your kin!
grunt
shriek
rinvoke artifact

~
> hitprcnt_prog 5~
snarl
if rand(7)
  say No, I refuse to fall!
  else
  if rand(13)
     say I shall not let you slay me!
     else
     if rand(14)
        say You think you are mighty?
        else
        if rand(17)
           say I shall overcome my wounds!
           else
           if rand(20)
              say You cannot defeat me!
              else
              if rand(25)
                 say Death is not an option!
                 else
                 if rand(33)
                    say Must...ignore...the...blood!
                    else
                    if rand(50)
                       say Gods, I am wounded!
                    endif
                 endif
              endif
           endif
        endif
     endif
   endif
endif~
