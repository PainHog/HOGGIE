# House of Ghouls — server environment. Copy to .env (gitignored) and fill in.

# WebSocket game server
PORT=4100

# Where the server reads MINE-audited world content (Step 1A JSON).
# Defaults to <repo>/houseofghouls-export/content if unset.
# CONTENT_DIR=houseofghouls-export/content

# Which MINE zones to load, and where new characters start.
# WORLD_AREAS=drazuni.are,drazpost.are
# START_ROOM=10300

# Emails auto-granted the admin role on login (bootstrap the owner). Comma-separated.
# ADMIN_EMAILS=you@example.com

# Supabase (persistence + accounts). URL + publishable key are safe to expose;
# the service_role key is a SECRET — server-side only, never ship it to a client.
SUPABASE_URL=https://yjjyocgxlsmnsxnyireu.supabase.co
SUPABASE_ANON_KEY=sb_publishable_jHACI1oLn0b2yjer3AZvzw_jWJuYMaC
SUPABASE_SERVICE_ROLE_KEY=
